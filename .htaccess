# mirunovomu.ru — Hugo static site

Options -Indexes
DirectoryIndex index.html

ErrorDocument 404 /404.html

# манифест иконок должен отдаваться своим типом, иначе Apache скажет text/plain
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# Служебное наружу не отдаём, даже если файл когда-нибудь попадёт в static/
<IfModule mod_authz_core.c>
  <FilesMatch "\.(md|markdown|py|sh|toml|yaml|yml|env|sql|log|bak|orig|swp|dat)$">
    Require all denied
  </FilesMatch>
  <FilesMatch "^\.">
    Require all denied
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # один канонический хост: без www, всегда https
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # снятые метки -> разделы (301). Пути в правилах — уже раскодированные:
  # Apache сравнивает с декодированным URL, поэтому %D0%B1... здесь не работают.
  RewriteRule ^tag/будущее\+России/?$ https://mirunovomu.ru/category/aktualno/ [R=301,L]
  RewriteRule ^tag/беларусь/?$ https://mirunovomu.ru/category/aktualno/ [R=301,L]
  RewriteRule ^tag/Знамя\+Культуры/?$ https://mirunovomu.ru/category/k-nauke-o-mysli/ [R=301,L]
  RewriteRule ^tag/каббала/?$ https://mirunovomu.ru/category/filosofija/ [R=301,L]
  RewriteRule ^tag/контакты/?$ https://mirunovomu.ru/page/contact_us/ [R=301,L]
  RewriteRule ^tag/обратная\+связь\+с\+автором/?$ https://mirunovomu.ru/page/contact_us/ [R=301,L]
  RewriteRule ^tag/общество/?$ https://mirunovomu.ru/category/aktualno/ [R=301,L]
  RewriteRule ^tag/Огонь/?$ https://mirunovomu.ru/category/zakony-plamennye/ [R=301,L]
  RewriteRule ^tag/почитание\+учителя/?$ https://mirunovomu.ru/category/k-nauke-o-mysli/ [R=301,L]
  RewriteRule ^tag/почта/?$ https://mirunovomu.ru/page/contact_us/ [R=301,L]
  RewriteRule ^tag/протесты/?$ https://mirunovomu.ru/category/aktualno/ [R=301,L]
  RewriteRule ^tag/хабаровск/?$ https://mirunovomu.ru/category/aktualno/ [R=301,L]

  # старая пагинация /home/next/N -> главная
  RewriteRule ^home/next/[0-9]+/?$ https://mirunovomu.ru/ [R=301,L]
  # старая HTML-карта сайта -> XML
  RewriteRule ^sitemap/?$ https://mirunovomu.ru/sitemap.xml [R=301,L]
  # первая страница пагинации -> корень раздела
  RewriteRule ^(.*)/page/1/?$ https://mirunovomu.ru/$1/ [R=301,L]

  # старые фиды MaxSite -> единый RSS
  RewriteRule ^comments/feed/?$ https://mirunovomu.ru/index.xml [R=301,L]
  RewriteRule ^(category|tag|author|cycle)/([^/]+)/feed/?$ https://mirunovomu.ru/index.xml [R=301,L]
  RewriteRule ^page/([^/]+)/feed/?$ https://mirunovomu.ru/index.xml [R=301,L]
  RewriteRule ^feed/?$ https://mirunovomu.ru/index.xml [R=301,L]

  # слеш в конце каталога
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ https://mirunovomu.ru/$1/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/rss+xml application/json image/svg+xml application/javascript
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 1 hour"
</IfModule>
